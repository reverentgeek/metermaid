{
	"name": "metermaid-site",
	"version": "1.0.0",
	"description": "Landing page for MeterMaid, a cross-platform LUFS / loudness meter.",
	"scripts": {
		"build:css": "tailwindcss -i src/css/styles.css -o _site/css/styles.css --minify",
		"build:11ty": "eleventy",
		"build": "pnpm build:11ty && pnpm build:css",
		"dev:css": "tailwindcss -i src/css/styles.css -o _site/css/styles.css --watch",
		"dev:11ty": "eleventy --serve",
		"dev": "node scripts/dev.mjs",
		"test": "pnpm build && playwright test",
		"test:install": "playwright install chromium"
	},
	"keywords": [
		"metermaid",
		"lufs",
		"loudness",
		"audio",
		"eleventy"
	],
	"author": "David Neal <david@reverentgeek.com> (https://reverentgeek.com/)",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.7",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/cli": "^4.3.3",
		"eleventy-plugin-edgejs": "^1.1.30",
		"markdown-it": "^15.0.3",
		"tailwindcss": "^4.3.3"
	}
}
