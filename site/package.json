{
	"name": "metermaid-site",
	"version": "1.0.0",
	"description": "Landing page for MeterMaid, a cross-platform LUFS / loudness meter.",
	"scripts": {
		"build:css": "tailwindcss -i src/css/styles.css -o _site/css/styles.css --minify",
		"build:11ty": "eleventy",
		"build": "pnpm build:11ty && pnpm build:css",
		"dev:css": "tailwindcss -i src/css/styles.css -o _site/css/styles.css --watch",
		"dev:11ty": "eleventy --serve",
		"dev": "node scripts/dev.mjs",
		"test": "pnpm build && playwright test",
		"test:install": "playwright install chromium"
	},
	"keywords": [
		"metermaid",
		"lufs",
		"loudness",
		"audio",
		"eleventy"
	],
	"author": "David Neal <david@reverentgeek.com> (https://reverentgeek.com/)",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.8",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/cli": "^4.3.5",
		"eleventy-plugin-edgejs": "^1.1.34",
		"markdown-it": "^15.0.3",
		"tailwindcss": "^4.3.5"
	}
}
