{
	"name": "metermaid-site",
	"version": "1.0.0",
	"description": "Landing page for MeterMaid, a cross-platform LUFS / loudness meter.",
	"scripts": {
		"build:css": "tailwindcss -i src/css/styles.css -o _site/css/styles.css --minify",
		"build:11ty": "eleventy",
		"build": "pnpm build:11ty && pnpm build:css",
		"dev:css": "tailwindcss -i src/css/styles.css -o _site/css/styles.css --watch",
		"dev:11ty": "eleventy --serve",
		"dev": "node scripts/dev.mjs",
		"test": "pnpm build && playwright test",
		"test:install": "playwright install chromium"
	},
	"keywords": [
		"metermaid",
		"lufs",
		"loudness",
		"audio",
		"eleventy"
	],
	"author": "David Neal <david@reverentgeek.com> (https://reverentgeek.com/)",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.7",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/cli": "^4.3.3",
		"eleventy-plugin-edgejs": "^1.1.29",
		"markdown-it": "^15.0.3",
		"tailwindcss": "^4.3.3"
	}
}
